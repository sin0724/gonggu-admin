NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# tianxia-crm KOL DB (캠페인 인플루언서 추가용, 서버 전용)
CRM_SUPABASE_URL=https://your-crm-project.supabase.co
CRM_SUPABASE_SERVICE_ROLE_KEY=your-crm-service-role-key

# tianxia-finance 재무관리 (셀러 입금 → 공구 사업부 실적 기록, 서버 전용)
FINANCE_SUPABASE_URL=https://your-finance-project.supabase.co
FINANCE_SUPABASE_SERVICE_ROLE_KEY=your-finance-service-role-key

# 구글 캘린더 구독 피드 (/api/calendar/ics) — 둘 다 있어야 구독 주소가 생성된다.
# 구글 서버가 로그인 없이 당겨가므로 토큰으로 보호하고 service role로 읽는다.
CALENDAR_FEED_TOKEN=아무-긴-랜덤-문자열
SUPABASE_SERVICE_ROLE_KEY=your-gonggu-admin-service-role-key

# 배포 주소 (선택). 없으면 요청 호스트로 자동 판단한다.
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# 팀 공용 구글 캘린더 ID (선택). 설정하면 "구글 캘린더에 추가"가 개인 캘린더 대신
# 이 캘린더를 기본 대상으로 잡고, 화면에 "팀 캘린더 열기" 버튼이 생긴다.
# 구글 캘린더 → 캘린더 설정 → "캘린더 통합"의 캘린더 ID를 넣는다.
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
